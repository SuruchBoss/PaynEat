{
  "name": "payneat-backend",
  "version": "1.0.0",
  "private": true,
  "description": "PaynEat POS - REST API + Realtime server for restaurant point of sale",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/reset.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "keywords": [
    "pos",
    "restaurant",
    "express",
    "socket.io",
    "clean-architecture"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "SuruchBoss",
    "url": "https://github.com/SuruchBoss"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuruchBoss/PaynEat.git",
    "directory": "backend"
  },
  "bugs": {
    "url": "https://github.com/SuruchBoss/PaynEat/issues"
  },
  "homepage": "https://github.com/SuruchBoss/PaynEat#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "supertest": "^7.1.4"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  }
}
